# SpielerPlus credentials
SPIELERPLUS_EMAIL=you@example.com
SPIELERPLUS_PASSWORD=change-me

# Optional: SpielerPlus "user id" to switch to after login. This is only
# needed for shared logins that manage several profiles/teams (see
# README "Multiple SpielerPlus profiles"). Leave unset for a normal
# single-profile account.
SPIELERPLUS_USER_ID=

# Google Calendar
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_PATH=google_credentials.json
GOOGLE_TOKEN_PATH=google_token.json

# IANA timezone used when creating Google Calendar events
CALENDAR_SYNC_TIMEZONE=Europe/Berlin

# Tag stored on every event created by this tool (via an extended
# property) so sync can find and manage only its own events.
CALENDAR_SYNC_TAG=spielerplus-sync

# Optional: path to a TOML file defining multiple sync jobs (one
# SpielerPlus profile -> Google Calendar mapping each), for logins that
# manage several teams/profiles. Leave unset to run in the normal
# single-job mode using the settings above. See jobs.example.toml and
# the README "Multiple jobs" section.
CALENDAR_SYNC_JOBS_FILE=

# Optional: defaults for `calendar-sync player-list`, which fills the
# association's player list PDF (see README "Player lists"). Each can
# also be set per job in the jobs file, or per run on the command line.
CALENDAR_SYNC_CLUB_NAME=
# One of: e-junioren, f-junioren, bambini (short forms like "F" work too)
CALENDAR_SYNC_AGE_CLASS=
CALENDAR_SYNC_FORM_TEMPLATE=KiFu-Spielerliste.pdf
