# SpielerPlus credentials
SPIELERPLUS_EMAIL=you@example.com
SPIELERPLUS_PASSWORD=change-me

# Optional: SpielerPlus "user id" to switch to after login. This is only
# needed for shared logins that manage several profiles/teams (see
# README "Multiple SpielerPlus profiles"). Leave unset for a normal
# single-profile account.
SPIELERPLUS_USER_ID=

# Google Calendar
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_PATH=google_credentials.json
GOOGLE_TOKEN_PATH=google_token.json

# IANA timezone used when creating Google Calendar events
CALENDAR_SYNC_TIMEZONE=Europe/Berlin

# Tag stored on every event created by this tool (via an extended
# property) so sync can find and manage only its own events.
CALENDAR_SYNC_TAG=spielerplus-sync
