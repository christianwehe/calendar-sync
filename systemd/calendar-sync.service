[Unit]
Description=calendar-sync: sync SpielerPlus events into Google Calendar
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__PROJECT_DIR__
ExecStart=__CALENDAR_SYNC_BIN__ sync
# All configuration (SpielerPlus/Google credentials, optional multi-job
# jobs file, ...) is read from __PROJECT_DIR__/.env and, if configured,
# __PROJECT_DIR__/jobs.toml -- see .env.example and jobs.example.toml.
# Nothing needs to be duplicated into this unit file.

# This file is generated by scripts/install-systemd.sh from
# systemd/calendar-sync.service -- re-run that script after editing the
# template, rather than editing the installed copy directly.
